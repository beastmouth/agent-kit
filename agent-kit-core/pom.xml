<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.beastmouth.kit</groupId>
        <artifactId>agent-kit</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>agent-kit-core</artifactId>
    <name>agent-kit-core</name>
    <description>核心：模型协议、工具注册、子 Agent 编排、Provider 接入、观测与评测</description>

    <dependencies>
        <!-- Spring 容器能力：@Component / @ConfigurationProperties / ObjectProvider -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 观测：指标 API 只在代码里用 MeterRegistry，具体 registry 由使用方选（prometheus） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- 观测：只用 OpenTelemetry API 开 span，SDK/exporter 由使用方决定，不绑定后端 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <!-- 观测明细落库：MyBatis-Plus 写 ai_* 表（Boot 4 专用 starter，3.5.15+ 才兼容） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <!-- 上下文跨线程透传：Reactor / 线程池里取 ToolExecutionContext 靠它 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>transmittable-thread-local</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
