<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.beastmouth.kit</groupId>
    <artifactId>agent-kit</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>agent-kit</name>
    <description>可复用的 AI Agent 脚手架：多子 Agent 编排、工具注册、大模型接入、可观测性与质量评测</description>

    <modules>
        <module>agent-kit-core</module>
        <module>agent-kit-memory</module>
        <module>agent-kit-agentscope</module>
        <module>agent-kit-starter</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <fastjson2.version>2.0.53</fastjson2.version>
        <ttl.version>2.14.5</ttl.version>
        <milvus-sdk.version>2.5.14</milvus-sdk.version>
        <!--
            可选引擎的框架版本。只在 agent-kit-agentscope 里用到，core/memory 完全不引，
            所以换版本或干脆不引这个模块，都不影响脚手架其余部分。
        -->
        <agentscope.version>2.0.4</agentscope.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.beastmouth.kit</groupId>
                <artifactId>agent-kit-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beastmouth.kit</groupId>
                <artifactId>agent-kit-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beastmouth.kit</groupId>
                <artifactId>agent-kit-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.beastmouth.kit</groupId>
                <artifactId>agent-kit-agentscope</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                AgentScope BOM：只统一它的几个构件版本。
                刻意不引 agentscope-spring-boot-starter：它依赖 spring-boot-autoconfigure 4.0.1，
                与 Boot 3.3.5 冲突，装配由本仓库的 AgentScopeConfig 自己写。
            -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!--
            阿里云镜像未同步 io/agentscope（实测该路径 404），补官方源兜底。
            Maven 按声明顺序逐个尝试，命中即止，不影响其余构件仍走镜像；
            若 settings.xml 用 <mirrorOf>*</mirrorOf> 强制镜像，需为该 mirror 加
            <mirrorOf>*,!central-direct</mirrorOf> 例外，否则这里同样被改写。
        -->
        <repository>
            <id>central-direct</id>
            <url>https://repo1.maven.org/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>17</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          示例模块默认不参与构建：它是给接入方看的参考实现，不是脚手架的发布物。

          · 默认 `mvn clean package` 只构建 core / memory / starter 三个模块
          · `mvn -Pexamples clean package` 才把 examples/agent-kit-example 一起编进来
          · 示例的 pom 里已设 maven.install.skip / maven.deploy.skip，永远不会被发布

          这样做的原因：示例依赖 web 容器与 MySQL 驱动，把它的依赖和构建时间带进脚手架
          的默认路径没有意义；同时它又必须能一键跑起来验证，所以不能干脆挪出仓库。
        -->
        <profile>
            <id>examples</id>
            <modules>
                <module>examples/agent-kit-example</module>
            </modules>
        </profile>
        <!--
          运维工具默认不参与构建：给运维预建/校验/重建 Milvus collection 用，
          不是脚手架的发布物。`mvn -Ptools clean package` 才编进来。
        -->
        <profile>
            <id>tools</id>
            <modules>
                <module>agent-kit-tools</module>
            </modules>
        </profile>
    </profiles>
</project>
