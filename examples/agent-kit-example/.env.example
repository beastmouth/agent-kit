# =============================================================================
# agent-kit-example 本地环境变量模板
#
# 用法：cp .env.example .env，然后把真实值填进 .env（.env 已被 .gitignore 排除，
# 绝不提交）。application.yml 通过 spring.config.import 读取本文件，
# 改完重启生效，不需要 export。
#
# 硬性约束（AGENTS.md）：本文件只放占位假值；任何真实密钥、口令、非本机地址
# 只允许出现在 .env / 不入库的启动脚本里，绝不进 git。
# =============================================================================

# ---------------- 数据库（MySQL：会话与观测明细） ----------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---------------- Redis（会话锁与会话缓存） ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# ---------------- 引擎与模型 ----------------
# 引擎：agentscope（默认）| legacy
AGENT_KIT_ENGINE=agentscope
# 模型渠道：ollama（默认，需本机 Ollama）| deepseek | custom
AGENT_KIT_PROVIDER=ollama

# 本机 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# DeepSeek 渠道（AGENT_KIT_PROVIDER=deepseek 时必填）
DEEPSEEK_API_KEY=

# 自定义 OpenAI 兼容渠道（AGENT_KIT_PROVIDER=custom 时三个都必填）
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# ---------------- 链路导出（OTel → Langfuse，可选） ----------------
# 两个变量要么都给、要么都不给（给一个会每条 trace 白跑 401）
TRACE_ENABLED=false
LANGFUSE_OTLP_ENDPOINT=
LANGFUSE_AUTH_HEADER=
TRACE_SAMPLE=1.0

# ---------------- 记忆（Milvus + 嵌入模型，可选） ----------------
# 打开需要本机 Milvus(19530) 与 Ollama 里的 bge-m3
MEMORY_ENABLED=false
MILVUS_URI=http://localhost:19530
