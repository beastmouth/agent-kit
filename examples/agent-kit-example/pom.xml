<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.beastmouth.kit</groupId>
        <artifactId>agent-kit</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>agent-kit-example</artifactId>
    <name>agent-kit-example</name>
    <description>
        接入示例：一个假业务（待办 + 天气）跑通 Agent / Tool / RunContext / 会话与记忆四层。
        代码是给业务侧抄的，不是框架的一部分——可以整包删掉，不影响任何模块。
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <!-- 引入即装配；starter 里 memory 是 optional，示例要用记忆所以显式加 -->
        <dependency>
            <groupId>com.beastmouth.kit</groupId>
            <artifactId>agent-kit-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.beastmouth.kit</groupId>
            <artifactId>agent-kit-memory</artifactId>
        </dependency>
        <!--
            可选引擎。加在这里只是为了让示例能演示「同一份业务代码换个引擎跑」；
            真实项目不引这个坐标时，legacy 引擎照常工作，一个字节都不会多下载。
        -->
        <dependency>
            <groupId>com.beastmouth.kit</groupId>
            <artifactId>agent-kit-agentscope</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            可观测三层（照 family 项目实测过的配方）：
            actuator 提供 /actuator/prometheus 端点与 OTel 自动装配的入口；
            bridge-otel 把脚手架打的 OTel span 接进 Micrometer Tracing；
            exporter-otlp 把 span 推给 Langfuse（OTLP/HTTP）。
            三者都只在本模块——脚手架刻意只依赖 opentelemetry-api，SDK 由使用方决定。
            endpoint 不配（management.otlp.tracing 不出现）时埋点退化为 noop，零开销。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- core 里 lombok 是 optional，不会传递，示例自己声明一次 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 jar：java -jar 直接起一个带 /demo/chat 的服务 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.beastmouth.agentkit.example.DemoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
